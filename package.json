{
  "displayName": "Homebridge Aqara IR Controller Lite",
  "name": "homebridge-aqara-ir-controller-lite",
  "version": "2.0.0",
  "description": "A simple plugin that exposes Aqara Ir AC control as a Thermostat",
  "license": "MIT",
  "homepage": "https://github.com/lesterrry/Homebridge-Aqara-IR-Controller",
  "repository": {
    "type": "git",
    "url": "https://github.com/lesterrry/Homebridge-Aqara-IR-Controller.git"
  },
  "bugs": {
    "url": "https://github.com/lesterrry/Homebridge-Aqara-IR-Controller/issues"
  },
  "author": "lesterrry",
  "engines": {
    "node": ">=10.17.0",
    "homebridge": ">=1.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link --registry https://registry.npmjs.org && nodemon"
  },
  "keywords": [
    "homebridge-plugin",
    "aqara",
    "ir",
    "ac"
  ],
  "dependencies": {
    "axios": "^1.7.9",
    "homebridge-lib": "^7.1.0"
  },
  "devDependencies": {
    "homebridge": "^1.2.2",
    "@eslint/js": "^9.14.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.8.6",
    "eslint": "^9.14.0",
    "nodemon": "^3.1.7",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2"
  }
}
